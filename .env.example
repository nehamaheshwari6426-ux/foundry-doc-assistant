# Azure Foundry / OpenAI v1 endpoint configuration
# -------------------------------------------------
# Copy this file to .env and fill in your values.
# .env MUST be gitignored — never commit it.

# Base URL for your Foundry resource's OpenAI v1 endpoint.
# Format: https://{your-resource-name}.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_BASE_URL=https://foundry-nm-portfolio.services.ai.azure.com/openai/v1

# Access key from Foundry portal: Models + endpoints -> deployment row.
# Same key works for all deployments on this Foundry resource.
AZURE_FOUNDRY_API_KEY=replace-with-actual-key

# Deployment names exactly as they appear in the Foundry portal's
# Models + endpoints list. Edit if your deployment names differ.
GENERATOR_DEPLOYMENT=gpt-4o
EMBEDDING_DEPLOYMENT=text-embedding-3-small
